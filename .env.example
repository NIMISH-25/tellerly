# Copy to .env — never commit the real file.

# Google AI Studio API key. Used ONLY by discovery runs (Phase 2.2) —
# deterministic replay never calls a model and must work with this unset.
# google-genai also accepts GEMINI_API_KEY.
GOOGLE_API_KEY=

# TELLERLY_GEMINI_MODEL=gemini-3.5-flash-lite

# Base URL of the target app instance the automation is pointed at.
TELLERLY_TARGET_URL=http://127.0.0.1:8000

# Optional path overrides (defaults: <repo>/evidence and <repo>/capabilities).
# TELLERLY_EVIDENCE_DIR=
# TELLERLY_CAPABILITIES_DIR=
