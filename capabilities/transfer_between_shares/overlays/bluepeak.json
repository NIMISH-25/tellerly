          {
            "confidence": 1.0,
            "note": "authored for tenant bluepeak — accessible role + tenant caption",
            "strategy": "role",
            "role": "button",
            "name": "Log On"
          },
          {
            "confidence": 1.0,
            "note": "authored for tenant bluepeak — structural fallback on the tenant caption",
            "strategy": "css",
            "css": "input[value='Log On']"
          }
        ],
        "verify": {
          "control": "input",
          "name_attr": null,
